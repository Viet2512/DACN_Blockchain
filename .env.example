# Copy to .env, set credentials for a NEW database, or retain existing credentials.
MYSQL_DATABASE=traceability
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Used only to initialize a database with zero accounts.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# For phone QR, replace localhost with the Windows Wi-Fi/Ethernet IPv4.
# Use only the origin, without /trace, credentials, query or fragment.
PUBLIC_BASE_URL=http://localhost:3001
VITE_API_URL=/api

# Only used by an explicitly requested demo seed.
# TC-DEMO-V1 requires at least 12 characters. Never commit the actual value.
DEMO_PASSWORD=

# Enable only after Fabric v2 onboarding and runtime credentials exist.
# COMPOSE_FILE=docker-compose.yml:docker-compose.fabric.yml
