PORT=8080
PUBLIC_BASE_URL=http://localhost:3001
MYSQL_ENABLED=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=traceability
MYSQL_USER=
MYSQL_PASSWORD=
FABRIC_ENABLED=false
FABRIC_NETWORK_ROOT=../fabric-samples/test-network
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_CHANNEL=tracechannel-v2
FABRIC_CHAINCODE=traceability_v2
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Only used by an explicitly requested demo seed.
DEMO_PASSWORD=
# New namespace keeps the original ledger intact.
# Per-user identity references are stored in MySQL; FABRIC_NETWORK_ROOT is the protected runtime store.

# Explicitly enable manual invitation links only for local development.
# Production refuses invitations until a secure delivery transport is implemented.
NODE_ENV=development
